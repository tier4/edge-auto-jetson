#!/bin/bash

source {{ autoware_env_dir }}/autoware.env && true
source {{ autoware_env_dir }}/vehicle.env
source {{ autoware_env_dir }}/jetson.env

source /opt/ros/humble/install/setup.bash
source {{ perception_application_base_path }}/{{ perception_application_directory_name }}/install/setup.bash

mkdir -p {{ perception_application_ros_log_dir }}
export ROS_LOG_DIR={{ perception_application_ros_log_dir }}

{% if fool_proof_check | bool %}
pass_call_diag=true
{% endif %}

if [ "$VEHICLE_MODEL" == "j6_gen2" ]; then
    while [[ ! -e /var/run/mgbe1-ready ]]; do
        {% if fool_proof_check | bool %}
            if [ "$pass_call_diag" = true ]; then
                call_diag --status "Error" \
                        --mrm_name_suffix "$HOSTNAME"_mgbe1-ready \
                        --event_id "Network Interface Error" \
                        --message "/var/run/mgbe1-ready is not found" \
                        --impact "Ethernet communication unavailable"
                pass_call_diag=false
            fi
        {% endif %}
        sleep 1
    done
    if [ "$pass_call_diag" = false ]; then
        call_diag --status "Ok" \
                --mrm_name_suffix "$HOSTNAME"_mgbe1-ready \
                --event_id "none" \
                --message "none" \
                --impact "none"
        pass_call_diag=true
    fi
fi

{% if perception_type == "tlr" %}
ros2 launch edge_auto_jetson_launch edge_auto_multi_launch_engine.launch.py \
      build_engine_only:=true object_recognition_camera_ids:=[0] \
      traffic_light_camera_ids:=[0] camera_driver_camera_ids:=[] live_sensor:=false \
      container_name:="none" use_multithread:=true yolox_precision:=int8
{% else %}
ros2 launch edge_auto_jetson_launch edge_auto_multi_launch_engine.launch.py \
      build_engine_only:=true object_recognition_camera_ids:=[0] \
      traffic_light_camera_ids:=[] camera_driver_camera_ids:=[] live_sensor:=false \
      container_name:="none" use_multithread:=true yolox_precision:=int8
{% endif %}

{% for i in range(video_num) %}
while [[ ! -e /dev/video{{ i }} ]]; do
    {% if fool_proof_check | bool %}
    if [ "$pass_call_diag" = true ]; then
        call_diag --status "Error" \
                --mrm_name_suffix "$HOSTNAME"_camera \
                --event_id "device not found" \
                --message "/dev/video{{ i }} is not found" \
                --impact "camera functionality unavailable"
        pass_call_diag=false
    fi
    {% endif %}
    sleep 1
done

{% if fool_proof_check | bool %}
if [ "$pass_call_diag" = false ]; then
    call_diag --status "Error" \
            --mrm_name_suffix "$HOSTNAME"_camera \
            --event_id "device not found" \
            --message "/dev/video{{ i }} is not found" \
            --impact "camera functionality unavailable"
    pass_call_diag=true
fi
{% endif %}

{%endfor%}

ros2 launch edge_auto_jetson_launch edge_auto_jetson.launch.xml
