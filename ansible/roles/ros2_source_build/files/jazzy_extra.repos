# Extra packages for Jazzy source build (vision, image, nav, etc.).
# Use with ros2_source_build_use_bundled_extra_repos: true or provide your own URL.
repositories:
  ros2_tools/ros-perception/vision_opencv:
    type: git
    url: https://github.com/ros-perception/vision_opencv.git
    version: rolling # There is no jazzy branch. Reference: https://github.com/ros-perception/vision_opencv/issues/553
  ros2_tools/ros-perception/vision_msgs:
    type: git
    url: https://github.com/ros-perception/vision_msgs.git
    version: jazzy
  ros2_tools/ros-perception/image_pipeline:
    type: git
    url: https://github.com/ros-perception/image_pipeline.git
    version: jazzy
  ros2_tools/ros-perception/image_transport_plugins:
    type: git
    url: https://github.com/ros-perception/image_transport_plugins.git
    version: jazzy
  ros2_tools/ros-perception/pcl_msgs:
    type: git
    url: https://github.com/ros-perception/pcl_msgs.git
    version: ros2
  ros2_tools/ros-perception/perception_pcl:
    type: git
    url: https://github.com/ros-perception/perception_pcl.git
    version: jazzy
  ros2_tools/ros-geographic-info/geographic_info:
    type: git
    url: https://github.com/ros-geographic-info/geographic_info.git
    version: ros2
  ros2_tools/ros/angles:
    type: git
    url: https://github.com/ros/angles.git
    version: ros2
  ros2_tools/ros/diagnostics:
    type: git
    url: https://github.com/ros/diagnostics.git
    version: ros2-jazzy
  ros2_tools/ros/filters:
    type: git
    url: https://github.com/ros/filters.git
    version: ros2
  ros2_tools/ros-planning/navigation2:
    type: git
    url: https://github.com/ros-planning/navigation2.git
    version: jazzy
  ros2_tools/boldhearts/ros2_v4l2_camera:
    type: git
    url: https://gitlab.com/boldhearts/ros2_v4l2_camera.git
    version: jazzy
  ros2_tools/flynneva/udp_msgs:
    type: git
    url: https://github.com/flynneva/udp_msgs.git
    version: main
  ros2_tools/DLu/tf_transformations:
    type: git
    url: https://github.com/DLu/tf_transformations.git
    version: main
  ros2_tools/KIT-MRT/mrt_cmake_modules:
    type: git
    url: https://github.com/KIT-MRT/mrt_cmake_modules.git
    version: 1.0.11
  ros2_tools/ANYbotics/grid_map:
    type: git
    url: https://github.com/ANYbotics/grid_map.git
    version: jazzy
